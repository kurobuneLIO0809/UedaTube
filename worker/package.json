{
  "name": "school-nico-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply school-nico-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply school-nico-db --remote",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
