// School NICO API の Cloudflare Workers 設定
// 秘密情報（合言葉・署名鍵）はここに書かず、`npx wrangler secret put <名前>` で登録してください。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-nico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // D1：動画情報・コメント。database_id は `npx wrangler d1 create school-nico-db` の出力に置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-nico-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // R2：動画ファイル本体（非公開バケット。公開URLやカスタムドメインは設定しない）
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "school-nico-videos" }],

  // Cron Trigger：5分ごとに期限切れ動画を削除
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // GitHub Pages のオリジン（https://<ユーザー名>.github.io）。複数ある場合はカンマ区切り
    "ALLOWED_ORIGINS": "https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5173",
    // アップロードできる動画の最大サイズ（バイト）。初期値 500MB
    "MAX_UPLOAD_BYTES": "524288000",
    // 分割アップロード1回のサイズ（バイト）。5MiB以上・95MiB以下。初期値 10MiB
    "UPLOAD_PART_BYTES": "10485760",
    "VIEWER_TOKEN_TTL_SECONDS": "28800",
    "ADMIN_TOKEN_TTL_SECONDS": "7200",
    "MEDIA_TOKEN_TTL_SECONDS": "900"
  }
}
