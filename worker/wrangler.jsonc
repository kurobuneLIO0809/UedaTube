// School NICO API の Cloudflare Workers 設定
// 秘密情報（合言葉・署名鍵）はここに書かず、`npx wrangler secret put <名前>` で登録してください。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-nico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // D1：動画情報・コメント。
  // database_id はここに直接書かず、GitHub Actions の Variables「CLOUDFLARE_D1_DATABASE_ID」の値を
  // デプロイ時にワークフロー（.github/workflows/deploy-worker.yml）が書き込みます。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-nico-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Workers KV：動画（塊に分割）とサムネイル。無料プラン（合計1GB）で使う。支払い方法の登録は不要。
  // id はここに直接書かず、GitHub Actions の Variables「CLOUDFLARE_KV_NAMESPACE_ID」の値を
  // デプロイ時にワークフローが書き込みます。
  "kv_namespaces": [{ "binding": "MEDIA", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],

  // Cron Trigger：5分ごとに期限切れ動画を削除
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // GitHub Pages のオリジン。ブラウザが送るオリジンは小文字なので小文字で書く。複数ある場合はカンマ区切り
    // （ローカル開発では worker/.dev.vars の ALLOWED_ORIGINS で上書きします）
    "ALLOWED_ORIGINS": "https://kurobunelio0809.github.io",
    // アップロードできる動画1本の最大サイズ（バイト）。初期値 200MiB
    "MAX_UPLOAD_BYTES": "209715200",
    // 分割アップロード1回（＝KV に保存する塊1つ）のサイズ（バイト）。1MiB〜24MiB。初期値 8MiB
    "UPLOAD_PART_BYTES": "8388608",
    // KV に保存してよい合計（バイト）。無料プランの上限1GBより少なくする。初期値 900MiB
    "KV_STORAGE_LIMIT_BYTES": "943718400",
    // KV の1日あたりの操作回数の上限（無料プランは各1,000回。余裕を残して止める）
    "KV_DAILY_WRITE_LIMIT": "900",
    "KV_DAILY_DELETE_LIMIT": "900",
    "KV_DAILY_LIST_LIMIT": "900",
    "VIEWER_TOKEN_TTL_SECONDS": "28800",
    "ADMIN_TOKEN_TTL_SECONDS": "7200",
    "MEDIA_TOKEN_TTL_SECONDS": "900"
  }
}
